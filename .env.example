# Pharos Mainnet default network for normal pre-sign checks
PHAROS_MAINNET_NETWORK_NAME=pharos-mainnet
PHAROS_MAINNET_RPC_URL=https://rpc.pharos.xyz
PHAROS_MAINNET_CHAIN_ID=1672
PHAROS_MAINNET_NATIVE_SYMBOL=PROS
PHAROS_MAINNET_EXPLORER_URL=https://pharosscan.xyz/
# Optional alternate Pharos Mainnet RPC
PHAROS_MAINNET_RPC_URL_ALT=https://infra.originstake.com/pharos/evm
# Pharos Atlantic testnet proof network (used for deployed honeypot demo contracts)
PHAROS_NETWORK_NAME=atlantic-testnet
PHAROS_RPC_URL=https://atlantic.dplabs-internal.com            # verified: https://docs.pharosnetwork.xyz/network-overview/pharos-networks
PHAROS_WS_URL=wss://atlantic.dplabs-internal.com               # verified: https://docs.pharosnetwork.xyz/network-overview/pharos-networks
PHAROS_CHAIN_ID=688689                                         # verified: official Skill Engine assets/networks.json and eth_chainId probe
PHAROS_NATIVE_SYMBOL=PHRS                                      # verified: official Skill Engine assets/networks.json
PHAROS_EXPLORER_URL=https://atlantic.pharosscan.xyz/           # verified: https://docs.pharosnetwork.xyz/network-overview/pharos-networks
PHAROS_EXPLORER_API=https://api.socialscan.io/pharos-atlantic-testnet # verified: official Skill Engine assets/networks.json
PHAROS_EXPLORER_VERIFY_API=https://api.socialscan.io/pharos-atlantic-testnet/v1/explorer/command_api/contract # verified: official Skill Engine references/contract.md
PHAROS_FAUCET_URL=https://stakely.io/faucet/pharos-atlantic-testnet-phrs


# Optional multi-chain EVM RPC overrides for live pre-sign checks.
# If unset, Foresight uses public default RPC URLs where available.
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
BASE_RPC_URL=https://mainnet.base.org
POLYGON_RPC_URL=https://polygon-rpc.com
BSC_RPC_URL=https://bsc-dataseed.binance.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
OPTIMISM_RPC_URL=https://mainnet.optimism.io
# Legacy testnet kept for compatibility with older docs, not the default.
PHAROS_LEGACY_CHAIN_ID=688688
PHAROS_LEGACY_RPC_URL=https://testnet.dplabs-internal.com
PHAROS_LEGACY_EXPLORER_URL=https://testnet.pharosscan.xyz/

# Engine / anvil
ANVIL_PORT=8546
FORK_BLOCK=23559136
FORESIGHT_SIM_MODE=live
FORESIGHT_ALLOW_FIXTURE_FALLBACK=false
NEW_CONTRACT_WINDOW=5000
VALUE_WARN_PCT=90
USE_LLM=false
ANTHROPIC_API_KEY=

# Demo accounts / deploy
DEPLOYER_PK=
# Non-owner demo wallet used for pre-flight eth_call scenarios.
# It does not need a private key for simulation.
DEMO_AGENT_ADDRESS=0xa1b2000000000000000000000000000000000001

# Real Pharos Atlantic demo deployment.
ADDR_USDC=0x5420f2D7c9219FD6E7d44b571762D1aa4824cDFc
ADDR_WPHRS=0x6C21fA4468d4bCd05FCb628addF187574C84fAAC
ADDR_MOON=0xCE26F3e00AE932C420A30E52A93bb141C543ECdf
ADDR_ROUTER=0x4d7C3EF2d8553F9502b7EcbAB056F1981C89BadA
ADDR_PROBE=0x4d7c79F36EFD1E78f986B8E422312Be2e7D0Fc83

# Dashboard
NEXT_PUBLIC_ENGINE_URL=
